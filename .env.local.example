# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Meta Graph API access token with at least `ads_read` permission.
META_ACCESS_TOKEN=

# One or more ad account ids, comma-separated, each with the "act_" prefix.
# The first one is used by default when no accountId is requested.
# e.g. act_123456789012345,act_223456789012345
META_AD_ACCOUNT_IDS=

# Graph API version currently used in the Meta developer dashboard, e.g. v21.0
META_GRAPH_API_VERSION=
